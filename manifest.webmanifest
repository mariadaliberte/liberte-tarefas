{
  "name": "Liberte",
  "short_name": "Liberte",
  "description": "Tarefas e compromissos integrados ao Google Agenda.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f5f3",
  "theme_color": "#5b2a4e",
  "icons": [
    {
      "src": "icons/icon-192-v2.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "audio/*", "application/pdf", ".ogg", ".opus", ".m4a", ".pdf"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Nova tarefa",
      "url": "./?focus=1"
    }
  ]
}